# Large source/reference assets
assets/originals/** filter=lfs diff=lfs merge=lfs -text
assets/references/** filter=lfs diff=lfs merge=lfs -text

# Public previews should remain normal Git blobs for GitHub rendering.
assets/exports/** -filter -diff -merge -text
assets/thumbnails/** -filter -diff -merge -text

# Design source files
*.psd filter=lfs diff=lfs merge=lfs -text
*.psb filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.afdesign filter=lfs diff=lfs merge=lfs -text
*.clip filter=lfs diff=lfs merge=lfs -text
*.kra filter=lfs diff=lfs merge=lfs -text
*.procreate filter=lfs diff=lfs merge=lfs -text

# Archives and packaged exports
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
